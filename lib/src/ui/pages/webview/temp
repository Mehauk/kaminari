  Future<void> _handleImport(BuildContext context) async {
    final cubit = context.read<WebviewCubit>();
    final llmCubit = context.read<LlmCubit>();

    // 1. Check if model is installed
    if (llmCubit.state.status != LlmStatus.installed) {
      if (llmCubit.state.status == LlmStatus.notInstalled) {
        // Show confirmation dialog for the 2GB download
        final bool? confirm = await showDialog<bool>(
          context: context,
          builder: (context) => AlertDialog(
            title: const Text('AI Model Required'),
            content: const Text(
              'To import reading material, a ~2GB model needs to be downloaded. This only happens once.',
            ),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(context, false),
                child: const Text('CANCEL'),
              ),
              FilledButton(
                onPressed: () => Navigator.pop(context, true),
                child: const Text('DOWNLOAD'),
              ),
            ],
          ),
        );

        if (confirm != true) return;
      }
      await llmCubit.downloadAndInstall();

      // 2. Wait for installation to complete if it's downloading
      if (llmCubit.state.status == LlmStatus.downloading ||
          llmCubit.state.status == LlmStatus.initial) {
        await for (final state in llmCubit.stream) {
          if (state.status == LlmStatus.installed) break;
          if (state.status == LlmStatus.error) {
            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(
                content: Text(state.errorMessage ?? 'Download failed'),
                backgroundColor: KaminariTheme.error,
              ),
            );
            return;
          }
        }
      }
    }

    if (!mounted) return;

    cubit.setImporting(true);

    try {
      // 1. Get the minified tree using your existing JS constant
      final String miniTree =
          await _controller.runJavaScriptReturningResult(minTreeExtFn)
              as String;

      // 2. First LLM Pass: Identify Targets
      final String discoveryJson = await _runInference(
        context,
        _buildDiscoveryPrompt(miniTree),
      );
      final Map<String, dynamic> selectors = jsonDecode(
        _sanitizeLlmJson(discoveryJson),
      );

      // 3. Second JS Pass: Targeted Extraction
      // Use the selectors identified by the LLM to pull real text from the live DOM
      final String extractionJs =
          """
      (function() {
        const getTxt = (sel) => document.querySelector(sel)?.innerText?.trim() || "";
        const getMeta = (p) => document.querySelector(`meta[property="\${p}"], meta[name="\${p}"]`)?.content || "";
        
        return {
          "title": getTxt("${selectors['title']}") || document.title,
          "author": getTxt("${selectors['author']}"),
          "synopsis": getTxt("${selectors['synopsis']}") || getMeta('og:description'),
          "cover": getMeta('og:image'),
          "chapters": Array.from(document.querySelectorAll("${selectors['chapter']}"))
                        .map(a => a.innerText.trim())
                        .filter(t => t.length > 0)
        };
      })()
    """;

      final String rawData =
          await _controller.runJavaScriptReturningResult(extractionJs)
              as String;
      final Map<String, dynamic> scrapedData = jsonDecode(jsonDecode(rawData));

      // 4. Second LLM Pass: Final Object Construction
      // Now pass the raw scraped text back to the LLM to clean up the BookDetails object
      final String finalPrompt =
          """
Convert this raw scraped data into a clean BookDetails JSON object.
Data: ${jsonEncode(scrapedData)}

JSON Schema:
{"title": "string", "romaji": "string", "author": "string", "synopsis": "string"}
""";

      final String finalJsonOutput = await _runInference(context, finalPrompt);

      final BookDetails extractedBook = _parseToBookDetails(
        llmOutput: finalJsonOutput,
        scrapedData: scrapedData,
      );

      print(extractedBook);

      cubit.setImporting(false);
      // Navigate to details or update state here
    } catch (e) {
      print("Import Error: $e");
      cubit.setExtractionFailed(true);
      cubit.setImporting(false);
    }
  }

  // Helper to clean LLM markdown backticks
  String _sanitizeLlmJson(String input) {
    if (input.contains('```')) {
      return input.split('```json').last.split('```').first.trim();
    }
    return input.trim();
  }

  BookDetails _parseToBookDetails({
    required String llmOutput,
    required Map<String, dynamic> scrapedData,
  }) {
    final Map<String, dynamic> llm = jsonDecode(_sanitizeLlmJson(llmOutput));
    final List<dynamic> rawChapters = scrapedData['chapters'] ?? [];

    final chapters = rawChapters
        .asMap()
        .entries
        .map(
          (e) => ChapterInfo(
            number: e.key + 1,
            title: e.value.toString(),
            isRead: false,
          ),
        )
        .toList();

    return BookDetails(
      id: 'imp-${DateTime.now().millisecondsSinceEpoch}',
      title: llm['title'] ?? scrapedData['title'],
      titleRomaji: llm['romaji'] ?? llm['title'],
      author: llm['author'] ?? scrapedData['author'] ?? 'Unknown',
      coverUrl: scrapedData['cover'] ?? 'https://placehold.co/400x600',
      bookType: 'Web Novel',
      jlptLevel: 'N/A',
      synopsis: llm['synopsis'] ?? scrapedData['synopsis'],
      chapters: rawChapters
          .asMap()
          .entries
          .map(
            (e) => ChapterInfo(
              number: e.key + 1,
              title: e.value.toString(),
              isRead: false,
            ),
          )
          .toList(),
      totalPages: chapters.length,
      currentPage: 1,
      currentChapter: chapters.isNotEmpty ? chapters.first.title : 'Chapter 1',
      totalWordCount: chapters.length * 2500,
      estimatedMinutes: (chapters.length * 2500) ~/ 200,
      synopsisExpanded: false,
    );
  }

  /// Communicates with the local Llama model via LlmService
  Future<String> _runInference(BuildContext context, String prompt) async {
    // Access the service via the Cubit
    final llmService = context.read<LlmCubit>().llm;
    final StringBuffer responseBuffer = StringBuffer();

    try {
      // Collect the stream of tokens into a single string
      await for (final token in llmService.streamResponse(prompt)) {
        print(token);
        responseBuffer.write(token);
      }

      return responseBuffer.toString();
    } catch (e) {
      throw Exception("LLM Inference failed: $e");
    }
  }