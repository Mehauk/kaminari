       (async () => {
         const data = {url: document.location.href, firstPageUrl: document.body.querySelector('.c-pager__item--first').textContent.trim(), title: document.body.querySelector('.p-novel__title').textContent.trim(), author: document.body.querySelector('.p-novel__author > a').textContent.trim(), synopsis: document.body.querySelector('#novel_ex.p-novel__summary').textContent.trim(), chapters: null};
         data.chapters = await   (async () => {
     let chapters = [];
     let i = -1;
     let nextUrl = document.querySelector('.c-pager__item--first').href ?? document.location.href;
     while (nextUrl) {
       const html = await (await fetch(nextUrl)).text();
       const doc = new DOMParser().parseFromString(html, 'text/html');
       const pageChapters = Array.from(doc.querySelectorAll('.p-eplist__sublist')).map(e => {
       i += 1;
       return ({
         url: e.querySelector('a.p-eplist__subtitle')?.href,
         title: e.querySelector('a.p-eplist__subtitle')?.textContent.trim(),
         updatedDate: e.querySelector('.p-eplist__update')?.textContent.trim(),
         number: i
       })});
       chapters = chapters.concat(pageChapters);
       const nextBtn = doc.querySelector('.c-pager__item--next');
       nextUrl = (nextBtn && nextBtn.href !== document.location.href) ? nextBtn.href : null;
     }
     return chapters;
   })()
 ;
         return data;
       })()